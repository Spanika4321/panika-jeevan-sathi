# SEVA MARKET INDIA — environment variables (copy to .env locally)
#
# Secrets are read from the environment at boot. Never commit a real .env.

# development | production (production marks cookies Secure and tightens logs)
NODE_ENV=production

# Bind address / port
HOST=0.0.0.0
PORT=3000

# Number of trusted proxy hops (1 when behind Render/Railway/nginx)
TRUST_PROXY_HOPS=1

# Pin this to a long random string so provider sessions survive restarts
SESSION_SECRET=replace-with-a-long-random-secret

# Public canonical origin — used by sitemap.xml and robots.txt. No trailing slash.
SITE_URL=https://your-app.example.com

# Durable SQLite database path (on your persistent disk / volume)
SEVA_DB_FILE=/app/data/seva-market.db

# ---- local development overrides (optional) ---------------------------------
# Unset to use the default ./data/seva-market.db
# SEVA_DB_FILE=

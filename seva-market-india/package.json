{
  "name": "seva-market-india",
  "version": "0.1.0",
  "private": true,
  "description": "SEVA MARKET INDIA — India-wide local services marketplace. Customers find and contact local service providers by service + location + PIN code.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.mjs",
    "test:one": "node --test",
    "seed": "node scripts/seed.mjs",
    "migrate": "node scripts/migrate.mjs",
    "check": "node scripts/check.mjs",
    "supabase:sql": "node scripts/supabase-setup.mjs --sql",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "supabase:emit": "node scripts/supabase-setup.mjs --emit-insert --out-dir=supabase-data",
    "supabase:emit-csv": "node scripts/supabase-setup.mjs --emit-csv --out-dir=supabase-data",
    "storage:sql": "node scripts/storage-doctor.mjs --sql",
    "storage:doctor": "node scripts/storage-doctor.mjs",
    "storage:verify": "node scripts/storage-doctor.mjs --write",
    "storage:prove": "node scripts/prove-durability.mjs",
    "test:unit": "node --test tests/models.test.mjs tests/database.test.mjs tests/search.test.mjs",
    "test:http": "node --test tests/http.test.mjs tests/pages.test.mjs",
    "test:storage": "node --test tests/storage.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "marketplace",
    "local-services",
    "india",
    "service-providers",
    "pincode"
  ],
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {}
}

{
  "name": "seva-market-india",
  "version": "0.1.0",
  "private": true,
  "description": "SEVA MARKET INDIA \u2014 India-wide local services marketplace. Customers find and contact local service providers by service + location + PIN code.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.mjs",
    "test:one": "node --test",
    "seed": "node scripts/seed.mjs",
    "migrate": "node scripts/migrate.mjs",
    "check": "node scripts/check.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:status": "node scripts/db-status.mjs",
    "test:unit": "node --test tests/models.test.mjs tests/database.test.mjs tests/search.test.mjs",
    "test:http": "node --test tests/http.test.mjs tests/pages.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "marketplace",
    "local-services",
    "india",
    "service-providers",
    "pincode"
  ],
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {}
}

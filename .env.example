# PANIKA JEEVAN SATHI — environment variables
# Copy to ".env" in the project root. Everything works with zero configuration;
# the variables below only let you customise the deployment.

# Public site URL (SEO metadata + sitemap). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the SQLite database file is stored (default: <project>/data/panika.db).
# The database and all tables are created automatically on first start.
# DATA_DIR=/var/lib/panika-jeevan-sathi

# Password for the admin account auto-created on first run
# (admin email is fixed in src/lib/constants.ts → ADMIN_EMAIL).
# CHANGE THIS, and again in Settings after first login.
ADMIN_DEFAULT_PASSWORD=Panika@123

# When serving over plain HTTP (local dev / non-SSL host) set to true so the
# session cookie is not flagged Secure. Leave unset for HTTPS production.
# DISABLE_SECURE_COOKIE=true

# Server port (Node.js Application Manager / PM2 usually sets this for you)
# PORT=3000
